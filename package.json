{
  "name": "whiteboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "dependencies": {
    "@tldraw/assets": "3.10.1",
    "mime": "^4.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "throttleit": "^2.1.0",
    "tldraw": "3.10.1"
  },
  "devDependencies": {
    "@epic-web/config": "^1.17.2",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.22.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "modern-normalize": "^3.0.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "utools-api-types": "^6.1.0",
    "vite": "^6.2.1",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "lint-staged": {
    "*.{md,html,css}": "prettier --write",
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "pnpm": {
    "patchedDependencies": {
      "tldraw@3.10.1": "patches/tldraw@3.10.1.patch"
